# GitHub token for fetching starred repositories and accurate repo/commit counts.
# Without this, only public data is shown and commit counts will be 0.
# See: github.com → Settings → Developer settings → Personal access tokens → Fine-grained
# Required scopes: "Starring" → Read-only, "Contents" → Read-only, "Metadata" → Read-only
# For private repo count: also add "Repository metadata" → Read-only
GITHUB_TOKEN=

# Notion integration used by /api/contact
# 1. Create an internal integration at https://www.notion.so/profile/integrations
# 2. Copy the "Internal Integration Secret" here
NOTION_TOKEN=

# 3. Create a database in Notion (or let Claude create one after sharing a page
#    with the integration). Open the database, copy the ID from the URL:
#    https://www.notion.so/<workspace>/<DATABASE_ID>?v=...
NOTION_CONTACT_DATABASE_ID=
